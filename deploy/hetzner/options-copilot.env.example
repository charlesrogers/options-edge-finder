# /etc/options-copilot.env  —  chmod 600, owned by root
#
# Credentials for the options copilot's server-side jobs. They live here rather
# than inline in /etc/cron.d/coolify-apps, which is mode 0644 and therefore
# readable by every user and every process on a box running 50+ containers
# (FACT-4). The bearer token was sitting in it in plaintext next to PLY's.
#
# Install:
#   scp this file to /etc/options-copilot.env
#   chown root:root /etc/options-copilot.env
#   chmod 600      /etc/options-copilot.env
#
# Nothing here is in git. This example file carries the KEYS, never the VALUES.

# Bearer token for https://options.imprevista.com/api/cron/*
# Must match CRON_SECRET in Coolify (BOTH is_preview scopes) and the
# CRON_SECRET GitHub Actions secret. Drift between those three caused a 34-day
# silent outage on DayScore.
CRON_SECRET=

# Discord #red-alert webhook. Same value as the DISCORD_WEBHOOK GitHub secret.
DISCORD_WEBHOOK=

# Pushover — the channel that reaches Charles's phone for EMERGENCY alerts.
# Same values as the PUSHOVER_TOKEN / PUSHOVER_USER GitHub secrets.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Supabase, for the server-side position monitor once it runs here.
SUPABASE_URL=https://db.imprevista.com
SUPABASE_KEY=
